// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  triviaScores TriviaScore[]
  draftMatches DraftMatch[]
  draftPlayers DraftPlayer[]
}

model TriviaSession {
  id              String   @id @default(cuid())
  leagueContext   String   // NCAA, NFL, General
  difficulty      String   // Very Easy, Easy, Moderate, Hard, Very Hard, Football Junkie
  questionFormat  String   // True/False, Multiple Choice, Multi-Select, Chronological Ordering, Fill-in-the-Blank
  gameMode        String   // Local, Online
  winCondition    String   // Target Score or Total Questions
  targetScore     Int?
  totalQuestions  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  triviaScores TriviaScore[]
  questions    TriviaQuestion[]
}

model TriviaQuestion {
  id              String   @id @default(cuid())
  sessionId       String
  session         TriviaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question        String
  format          String   // True/False, Multiple Choice, Multi-Select, Chronological Ordering, Fill-in-the-Blank
  correctAnswer   String
  options         String[] // JSON array stored as text
  difficulty      String
  category        String   // Records, Rivalries, Game History, Coaching, Stadium, Mascot, Rules, Ring of Honor, HOF, Awards
  leagueContext   String   // NCAA, NFL
  teamFilter      String?
  conferenceFilter String?
  decadeFilter    String?  // 1940s-2020s+
  yearFilter      Int?
  playoffOnly     Boolean  @default(false)
  champsOnly      Boolean  @default(false)
  bowlGamesOnly   Boolean  @default(false)
  redactionFields String[] // Fields to redact based on question context
  createdAt       DateTime @default(now())

  answers         TriviaAnswer[]
}

model TriviaScore {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String
  session         TriviaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  score           Int
  correctAnswers  Int
  totalQuestions  Int
  accuracy        Float
  createdAt       DateTime @default(now())
}

model TriviaAnswer {
  id              String   @id @default(cuid())
  questionId      String
  question        TriviaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId          String
  selectedAnswer  String
  isCorrect       Boolean
  createdAt       DateTime @default(now())
}

model DraftMatch {
  id                  String   @id @default(cuid())
  team1Id             String
  team1                User     @relation(fields: [team1Id], references: [id], onDelete: Cascade)
  team2Id             String?
  team2                User?    @relation("team2", fields: [team2Id], references: [id], onDelete: SetNull)
  gameMode            String   // Local, Online
  evaluationScope     String   // Full Career, Best Single Season, Playoff Only, Championship Only, Bowl Game Only, Conference Championship Only
  status              String   @default("draft") // draft, completed
  team1Score          Int?     @default(0)
  team2Score          Int?     @default(0)
  winner              String?  // team1, team2, tie
  suddenDeathRound    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  startedAt           DateTime?
  completedAt         DateTime?

  rosterSlots         RosterSlot[]
  draftPlayers        DraftPlayer[]
  categories          DraftCategory[]
}

model RosterSlot {
  id              String   @id @default(cuid())
  matchId         String
  match           DraftMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId          String
  position        String   // QB, RB, WR/TE, DEF
  isFilledAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  draftPlayer     DraftPlayer?
}

model DraftPlayer {
  id              String   @id @default(cuid())
  matchId         String
  match           DraftMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  rosterSlotId    String   @unique
  rosterSlot      RosterSlot @relation(fields: [rosterSlotId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerName      String
  position        String
  category        String   // Category under which player was selected
  aiRating        Int      @default(0) // 1-100 scale
  aiAnalysis      String?
  statLog         String?  // JSON stringified stats
  pickedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DraftCategory {
  id              String   @id @default(cuid())
  matchId         String
  match           DraftMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId          String
  turnOrder       Int      // Which turn in the draft
  category        String   // The actual category string
  complexity      String   // 1-Way, 2-Way, 3-Way
  isRespun        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AIPlayerCache {
  id              String   @id @default(cuid())
  query           String   @unique
  category        String
  players         String   // JSON array of matching players
  ttl             DateTime // Time to live for cache
  createdAt       DateTime @default(now())
}

model ReSpin {
  id              String   @id @default(cuid())
  matchId         String   @unique
  match           DraftMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId          String
  usedAt          DateTime?
  createdAt       DateTime @default(now())
}
